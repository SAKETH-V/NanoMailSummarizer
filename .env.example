# Copy this file to .env and adjust paths if needed.
# Nothing here is secret by itself -- the actual secrets live in the
# files these paths point to (credentials.json, token.json), which are
# both gitignored and must never be committed.

# Path to the OAuth client secret file downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client IDs > Desktop app).
CREDENTIALS_PATH=credentials.json

# Path where the app will cache your OAuth token after first login.
# Created automatically on first run -- you don't need to create it.
TOKEN_PATH=token.json

# --- Phase 2: AI summarization ---

# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# This IS a real secret -- never commit your actual .env file.
ANTHROPIC_API_KEY=your-api-key-here

# Optional: override the model used for summarization. Defaults to
# claude-sonnet-4-6 if not set.
# SUMMARIZER_MODEL=claude-sonnet-4-6

# --- Phase 3: agent core ---

# Optional: override the model used for the tool-use agent loop.
# Defaults to claude-sonnet-4-6 if not set.
# AGENT_MODEL=claude-sonnet-4-6

# Optional: max tool calls per email before the agent is forced to
# give its final answer. Defaults to 5 if not set.
# AGENT_MAX_TOOL_CALLS=5

# --- Phase 4: persistence ---

# Optional: path to the SQLite database file. Defaults to
# nano_mail_agent.db in the project root if not set. Created
# automatically on first run.
# DB_PATH=nano_mail_agent.db
